---
// Ícono de línea. Hereda el color del texto; 20 px por defecto (16 en texto, 24 en pestañas, 28 en encabezados).
import type { IconName } from './icons';

interface Props { name: IconName; size?: number; label?: string; class?: string }
const { name, size = 20, label, class: className } = Astro.props;
const stroke = size === 16 ? 2.2 : size === 28 ? 1.7 : undefined;
---
<svg
  class:list={['ic', className]}
  style={`width:${size}px;height:${size}px${stroke ? `;stroke-width:${stroke}` : ''}`}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
><use href={`#i-${name}`} /></svg>

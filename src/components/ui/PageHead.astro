---
// Encabezado de página interior: etiqueta, H1 y entrada; el slot recibe acciones o badges.
interface Props { eyebrow: string; title: string; accent?: string; lede?: string }
const { eyebrow, title, accent, lede } = Astro.props;
---
<div class="relative z-[1] grid gap-[26px] justify-items-start">
  <p class="rise font-body text-[13px] font-semibold leading-none tracking-[.1em] uppercase text-accent">{eyebrow}</p>
  <h1 class="rise [animation-delay:.06s] text-[clamp(44px,6.4vw,84px)] font-extrabold leading-[.95] tracking-[-0.05em]">
    {title}{accent && <> <span class="text-accent">{accent}</span></>}
  </h1>
  {lede && <p class="rise [animation-delay:.12s] text-[clamp(18px,2vw,21px)] leading-normal text-ink-soft max-w-[40ch]">{lede}</p>}
  {Astro.slots.has('default') && <div class="rise [animation-delay:.18s] flex gap-3 flex-wrap"><slot /></div>}
</div>
